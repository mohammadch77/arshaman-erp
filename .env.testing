APP_ENV=testing
APP_KEY=base64:4myB3K8oFOSg/Qe5TjNpjLcdfBI72pJNhjjFGcYmR54=
APP_DEBUG=true

# لایه دفاعی دوم — نگاه کن CLAUDE.md بند ۹.۱. اگر Laravel به هر دلیلی این فایل را
# به‌جای .env بار کند (چون APP_ENV=testing است)، هرگز نباید به دیتابیس واقعی وصل شود.
# phpunit.xml هم همین مقادیر را به‌عنوان process env ست می‌کند و روی این فایل اولویت
# دارد؛ این فایل فقط fallback است برای اجرای تست بیرون از phpunit.xml (مثلاً IDE runner
# یا php artisan tinker --env=testing).
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BCRYPT_ROUNDS=4

BROADCAST_CONNECTION=null
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
APP_MAINTENANCE_DRIVER=file
